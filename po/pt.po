msgid "Keyboard shortcut"
msgstr "Atalho de teclado"

msgid "Keep your cursor on the current screen"
msgstr "Mantenha o cursor na tela atual"

msgid "Lock cursor to screen"
msgstr "Bloquear cursor na tela"

msgid "Enable Mouse Trap to change its shortcut."
msgstr "Ative o Mouse Trap para alterar o atalho."

msgid "Edit multi-step shortcuts in KDE Keyboard Shortcuts."
msgstr "Edite os atalhos de várias etapas nos Atalhos de teclado do KDE."

msgid "Could not read the shortcut from KDE."
msgstr "Não foi possível ler o atalho do KDE."

msgid "KDE could not apply this shortcut."
msgstr "O KDE não conseguiu aplicar este atalho."

msgid "This shortcut is already in use"
msgstr "Este atalho já está em uso"

msgid "Could not check shortcut availability."
msgstr "Não foi possível verificar a disponibilidade do atalho."

msgid "View project on GitHub"
msgstr "Ver o projeto no GitHub"

msgid "Leave a like on KDE Store"
msgstr "Deixe um like na KDE Store"
