msgid "Keyboard shortcut"
msgstr "Atajo de teclado"

msgid "Keep your cursor on the current screen"
msgstr "Manten el cursor en la pantalla actual"

msgid "Lock cursor to screen"
msgstr "Bloquear cursor a la pantalla"

msgid "Enable Mouse Trap to change its shortcut."
msgstr "Active Mouse Trap para cambiar su atajo."

msgid "Edit multi-step shortcuts in KDE Keyboard Shortcuts."
msgstr "Edite los atajos de varios pasos en Atajos de teclado de KDE."

msgid "Could not read the shortcut from KDE."
msgstr "No se pudo leer el atajo de KDE."

msgid "KDE could not apply this shortcut."
msgstr "KDE no pudo aplicar este atajo."

msgid "This shortcut is already in use"
msgstr "Este atajo ya está en uso"

msgid "Could not check shortcut availability."
msgstr "No se pudo comprobar la disponibilidad del atajo."

msgid "View project on GitHub"
msgstr "Ver el proyecto en GitHub"

msgid "Leave a like on KDE Store"
msgstr "Deja un like en KDE Store"
